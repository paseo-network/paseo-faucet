{
  "name": "paseo-faucet-fork-check",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fork": "chopsticks xcm -p chopsticks/asset-hub.yml -p chopsticks/people.yml -p chopsticks/bulletin.yml -p chopsticks/asset-hub-next.yml -p chopsticks/bulletin-next.yml -p chopsticks/people-next.yml",
    "precheck": "forge build --root ../contracts",
    "check": "tsx check.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@polkadot-api/metadata-builders": "0.15.2",
    "@polkadot-api/substrate-bindings": "0.21.2",
    "polkadot-api": "3.2.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "1.5.2",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
